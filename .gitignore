#-------------------------
# CodeIgniter 4
#-------------------------
vendor/

# Env files (never commit real credentials)
.env
.env.*
!.env.example

# Application runtime data
writable/cache/*
!writable/cache/index.html
writable/logs/*
!writable/logs/index.html
writable/session/*
!writable/session/index.html
writable/uploads/*
!writable/uploads/index.html
writable/debugbar/*
!writable/debugbar/index.html
writable/backups/
writable/*.sqlite
writable/*.sqlite-journal

# Views cache (CI4 stores compiled views under writable/cache)

# Test artifacts
tests/coverage*
phpunit
phpunit.xml
.phpunit.result.cache
.phpunit.cache/
build/
*.coverage

#-------------------------
# Operating System Junk
#-------------------------

# OS X
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# Linux
*~
*.swp
*.swo

# KDE directory preferences
.directory

# Linux trash folder which might appear on any partition or disk
.Trash-*

#-------------------------
# Logs & Temp Files
#-------------------------
*.log
php_errors.log
*.tmp
*.temp

#-------------------------
# IDE / Editors
#-------------------------

# Jetbrains (PHPStorm, etc)
.idea/
*.iml

# Netbeans
nbproject/
nbbuild/
nbdist/
.nb-gradle/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Visual Studio Code
.vscode/

# phpenv local config
.php-version

# Modules Testing
_modules/*

#-------------------------
# Databases / Dumps (security risk)
#-------------------------
*.sql
*.sql.gz
*.dump
app_auth_tokens.sql

#-------------------------
# Docker / Misc
#-------------------------
.vagrant
Vagrantfile
node_modules/

#-------------------------
# Local Debug / Scratch Scripts
#-------------------------
ipcheck.php
test_upsert.php
